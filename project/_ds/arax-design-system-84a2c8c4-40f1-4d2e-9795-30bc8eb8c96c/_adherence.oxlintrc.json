{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "ui_kits/instagram/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Rubik|Caveat|Neucha))/i]",
        "message": "Font not provided by the design system. Available: Rubik, Caveat, Neucha."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddressSticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|outline|style|key|ref|className|style|children)$/]",
        "message": "<AddressSticker> doesn't accept that prop. Declared props: children, size, color, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|paper|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'paper' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlavorTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<FlavorTag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlavorTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lemon|orange|leaf|rose|plum|sky)$/]",
        "message": "<FlavorTag> tone must be one of 'lemon' | 'orange' | 'leaf' | 'rose' | 'plum' | 'sky'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: src, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tilt|padding|image|imageHeight|style|key|ref|className|style|children)$/]",
        "message": "<PaperCard> doesn't accept that prop. Declared props: children, tilt, padding, image, imageHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SearchPill> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TornLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tilt|lined|pin|size|style|key|ref|className|style|children)$/]",
        "message": "<TornLabel> doesn't accept that prop. Declared props: children, variant, tilt, lined, pin, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TornLabel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hand|crayon|label)$/]",
        "message": "<TornLabel> variant must be one of 'hand' | 'crayon' | 'label'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
